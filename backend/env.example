# Database Connection (Neon PostgreSQL, Supabase, or Local Postgres)
DATABASE_URL=

# Clerk Authentication Keys (From https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Server Config
PORT=3000
NODE_ENV=development

GEMINI_API_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Comma-separated browser origins permitted to call the API in production.
# Example: https://app.example.com
CORS_ORIGIN=
