generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  clerkId      String  @unique
  username     String? @unique
  email        String  @unique
  authProvider String? @default("email")

  // Onboarding & Profile Fields
  isOnboarded     Boolean @default(false)
  fullName        String?
  avatarUrl       String?
  college         String?
  bio             String? @db.Text
  targetRole      String?
  experienceLevel String?

  // Account Status & Plan
  role    Role @default(USER)
  plan    Plan @default(FREE)
  credits Int  @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume         Resume[]
  jobDescription JobDescription[]
  sessions       InterviewSession[]
  payments       Payment[]
  creditLogs     CreditUsageLog[]

  @@map("users")
}

model Resume {
  id             String  @id @default(uuid())
  userId         String
  fileId         String?
  fileUrl        String?
  fileName       String?
  title          String
  content        String?
  aiSummary      String?
  skills         Json?
  experience     Json?
  education      Json?
  projects       Json?
  certifications Json?
  contact        Json?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sessions  InterviewSession[]
  owner     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

model JobDescription {
  id          String             @id @default(uuid())
  userId      String
  title       String
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sessions    InterviewSession[]
  owner       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("job_descriptions")
}

model InterviewSession {
  id               String           @id @default(uuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  mode             InterviewMode    @default(PRACTICE)
  status           SessionStatus    @default(ACTIVE)
  sessionType      SessionType      @default(MIXED)
  difficulty       Difficulty       @default(MEDIUM)
  durationMinutes  Int              @default(15)
  totalQuestions   Int              @default(5)           // 5 or 10 questions chosen by candidate
  currentQuestionNo Int             @default(1)
  totalScore       Float?
  aiFeedback       String?
  strengths        String[]         @default([])
  areasToImprove   String[]         @default([])
  competencyScores Json?
  transcript       Json?
  durationSec      Int?
  startedAt        DateTime?        @default(now())
  endedAt          DateTime?
  createdAt        DateTime         @default(now())
  
  answers          Answer[]
  creditLogs       CreditUsageLog[]
  jobDescription   JobDescription?  @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resume           Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions        Question[]
  @@index([userId])
  @@index([status])
  @@index([mode])
  @@index([userId, mode])
  @@map("interview_sessions")
}

model Question {
  id           String           @id @default(uuid())
  sessionId    String
  questionNo   Int
  questionText String
  questionType SessionType
  isFollowUp   Boolean          @default(false)       // Indicates if this is an adaptive probe
  parentQId    String?                                // Links to the question being probed
  aiVoiceId    String?
  askedAt      DateTime         @default(now())
  answer       Answer?
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@unique([sessionId, questionNo])
  @@map("questions")
}


model Answer {
  id              String           @id @default(uuid())
  questionId      String           @unique
  sessionId       String
  answerText      String?
  codeSnippet     String?
  codeLanguage    String?
  aiScore         Float?
  aiFeedback      String?
  keywordHit      Json?
  suggestedAnswer String?
  confidenceLevel Float?
  answerAt        DateTime?        @default(now())
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("answers")
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  plan           Plan
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR")
  gateway        String
  gatewayOrderId String   @unique
  status         String
  paymentDate    DateTime @default(now())
  creditAdded    Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model CreditUsageLog {
  id          String            @id @default(uuid())
  userId      String
  sessionId   String?
  creditsUsed Int
  action      String
  usedAt      DateTime          @default(now())
  session     InterviewSession? @relation(fields: [sessionId], references: [id])
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_usage_logs")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum SessionStatus {
  PENDING
  EVALUATING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionType {
  BEHAVIORAL
  TECHNICAL
  CODING
  MIXED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewMode {
  PRACTICE
  LIVE
}